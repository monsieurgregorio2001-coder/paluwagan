{
  "name": "online-paluwagan",
  "private": true,
  "version": "1.0.0",
  "description": "Demo of a rotating savings group (paluwagan) manager with a tested money ledger, risk flags and human-approved reminder drafts.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/house.mjs sync && vite build && node scripts/house.mjs 404",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "evidence": "node scripts/evidence.mjs",
    "evidence:check": "node scripts/evidence-shape.mjs",
    "eval:reminders": "vite-node scripts/eval-reminders.ts",
    "house:sync": "node scripts/house.mjs sync",
    "house:check": "node scripts/house.mjs check",
    "house:lock": "node scripts/house.mjs lock"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
